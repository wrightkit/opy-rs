rule "missing member actions":
    @Event eachPlayer
    eventPlayer.detach()
    eventPlayer.disableDeathSpectateAllPlayers()
    eventPlayer.disableDeathSpectateTargetHud()
    eventPlayer.disableNameplatesFor(getAllPlayers())
    eventPlayer.disableScoreboard()
    eventPlayer.disableTextChat()
    eventPlayer.disableVoiceChat(true, false, true)
    eventPlayer.enableDeathSpectateAllPlayers()
    eventPlayer.enableDeathSpectateTargetHud()
    eventPlayer.enableGamemodeHud()
    eventPlayer.enableGamemodeInWorldUi()
    eventPlayer.enableKillFeed()
    eventPlayer.enableMessages()
    eventPlayer.enableNameplatesFor(getAllPlayers())
    eventPlayer.enableScoreboard()
    eventPlayer.enableTextChat()
    eventPlayer.enableVoiceChat()
    eventPlayer.resetHeroAvailability()
    eventPlayer.setJumpVerticalSpeed(50)
    eventPlayer.setScore(5)
    eventPlayer.startTransformingThrottle(1, 2, Vector.UP)
    eventPlayer.stopAllHealingOverTime()
    eventPlayer.stopTransformingThrottle()
    eventPlayer.moveToTeam(Team.1)
    eventPlayer.moveToTeam(Team.2, 2)
    eventPlayer.startGrantingAssistFor(getAllPlayers())
    eventPlayer.startGrantingAssistFor(getAllPlayers(), AssistReeval.NONE)
