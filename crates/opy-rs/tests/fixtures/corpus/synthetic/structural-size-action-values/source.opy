#!optimizeForSize

globalvar arr
globalvar n
globalvar i
playervar parr
playervar pn
playervar pi

rule "values":
    @Event eachPlayer
    arr.append("")
    arr -= ""
    arr.remove("")
    n = min(n, "")
    n = max(n, "")
    n += ""
    n *= ""
    n /= ""
    arr[0] -= ""
    arr[0].append("")
    eventPlayer.parr.append("")
    eventPlayer.pn -= ""
    for i in range(""):
        pass
    for i in range("", 5):
        pass
    for i in range(1, 5, ""):
        pass
    for eventPlayer.pi in range(""):
        pass
