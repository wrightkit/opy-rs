#!optimizeForSize

rule "number rounding":
    @Event eachPlayer
    debug(2.675)
    debug(-0.001)
    debug(0.015)
    debug(-0.004)
    debug(0.125)
    debug(0.375)
    debug(1.125)
    debug(-0.125)
    debug(-0.005)
    debug(0.5)
    debug(1.005)
    debug(0.285)
    debug(1.45)
    debug(8.345)
    debug(-0.625)
    debug(100.005)
    debug(3.1)
    debug(-2.675)
    debug(0.875)
    bigMessage(eventPlayer, "{0}".format(2.675))
    bigMessage(eventPlayer, "{0}".format(-0.001))
    bigMessage(eventPlayer, "{0}".format(0.015))
    bigMessage(eventPlayer, "{0}".format(-0.004))
    bigMessage(eventPlayer, "{0}".format(0.125))
    bigMessage(eventPlayer, "{0}".format(0.375))
    bigMessage(eventPlayer, "{0}".format(1.125))
    bigMessage(eventPlayer, "{0}".format(-0.125))
    bigMessage(eventPlayer, "{0}".format(-0.005))
    bigMessage(eventPlayer, "{0}".format(0.5))
    bigMessage(eventPlayer, "{0}".format(1.005))
    bigMessage(eventPlayer, "{0}".format(0.285))
    bigMessage(eventPlayer, "{0}".format(1.45))
    bigMessage(eventPlayer, "{0}".format(8.345))
    bigMessage(eventPlayer, "{0}".format(-0.625))
    bigMessage(eventPlayer, "{0}".format(100.005))
    bigMessage(eventPlayer, "{0}".format(3.1))
    bigMessage(eventPlayer, "{0}".format(-2.675))
    bigMessage(eventPlayer, "{0}".format(0.875))
