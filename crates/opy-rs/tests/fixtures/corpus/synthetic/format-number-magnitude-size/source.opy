#!optimizeForSize

rule "number magnitudes":
    @Event eachPlayer
    debug(1234567.5)
    debug(9999999)
    debug(10000000)
    debug(-10000000)
    debug(10000001)
    debug(-10000001)
    debug(10000000.5)
    debug(99999999)
    debug(-99999999)
    debug(12345678.9)
    bigMessage(eventPlayer, "{0}".format(1234567.5))
    bigMessage(eventPlayer, "{0}".format(9999999))
    bigMessage(eventPlayer, "{0}".format(10000000))
    bigMessage(eventPlayer, "{0}".format(-10000000))
    bigMessage(eventPlayer, "{0}".format(10000001))
    bigMessage(eventPlayer, "{0}".format(-10000001))
    bigMessage(eventPlayer, "{0}".format(10000000.5))
    bigMessage(eventPlayer, "{0}".format(99999999))
    bigMessage(eventPlayer, "{0}".format(-99999999))
    bigMessage(eventPlayer, "{0}".format(12345678.9))
    bigMessage(eventPlayer, "{1} {0} {2}".format(10000001, 10000000, -99999999))
