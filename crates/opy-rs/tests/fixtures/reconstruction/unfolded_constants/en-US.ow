variables {
    global:
        0: A
        1: x
        2: y
    player:
        0: P
        1: result
}

rule ("Initialize global variables") {
    event { Ongoing - Global; }
    actions { Set Global Variable(x, Add(0, 1)); }
}

rule ("Global sets") {
    event { Ongoing - Global; }
    actions {
        Set Global Variable At Index(A, 1, Global.x);
        Set Global Variable At Index(A, Add(0, 1), Global.x);
        Set Global Variable At Index(A, Subtract(5, 4), Global.x);
        Set Global Variable At Index(A, Multiply(2, 3), Global.x);
        Set Global Variable At Index(A, Modulo(7, 4), Global.x);
        Set Global Variable At Index(A, Add(Global.x, 1), Global.x);
        Set Global Variable At Index(A, 1, Multiply(Add(0, 1), 3));
        Set Global Variable(x, Add(0, 1));
        Set Global Variable(x, Value In Array(Global.A, Add(0, 1)));
        Set Global Variable(x, Value In Array(Global.A, Subtract(1, 1)));
        Set Global Variable(x, First Of(Global.A));
        Modify Global Variable At Index(A, 1, Add, 2);
        Set Global Variable(y, If-Then-Else(True, Global.x, Global.y));
        Set Global Variable(y, Subtract(Global.x, 0));
        Set Global Variable(y, Add(Global.x, Global.x));
    }
}

rule ("Player sets") {
    event { Ongoing - Each Player; All; All; }
    actions {
        Set Player Variable At Index(Event Player, P, 1, Global.x);
        Set Player Variable At Index(Event Player, P, Add(0, 1), Global.x);
        Set Player Variable At Index(Event Player, P, Subtract(5, 4), Global.x);
        Set Player Variable At Index(Event Player, P, Multiply(2, 3), Global.x);
        Set Player Variable At Index(Event Player, P, Modulo(7, 4), Global.x);
        Set Player Variable At Index(Event Player, P, Add(Global.x, 1), Global.x);
        Set Player Variable At Index(Event Player, P, 1, Multiply(Add(0, 1), 3));
        Set Player Variable(Event Player, result, Add(0, 1));
        Set Player Variable(Event Player, result, Value In Array(Player Variable(Event Player, P), Add(0, 1)));
        Set Player Variable(Event Player, result, Value In Array(Player Variable(Event Player, P), Subtract(1, 1)));
        Set Player Variable(Event Player, result, First Of(Player Variable(Event Player, P)));
        Modify Player Variable At Index(Event Player, P, 1, Add, 2);
    }
}

rule ("Preserved condition") {
    event { Ongoing - Each Player; All; All; }
    conditions {
        Compare(Is Alive(Event Player), ==, True);
        disabled Compare(Global.x, ==, Add(1, 1));
    }
    actions {
        disabled If(Compare(Global.x, <, Add(1, 1)));
            While(Compare(Global.x, <, Add(2, 2)));
                Set Global Variable(x, Add(1, 1));
            End;
        End;
        Set Global Variable(y, 1);
    }
}
