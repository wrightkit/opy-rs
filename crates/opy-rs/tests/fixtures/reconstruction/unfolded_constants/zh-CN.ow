变量 {
    全局:
        0: A
        1: x
    玩家:
        0: P
        1: result
}

规则 ("Initialize global variables") {
    事件 { 持续 - 全局; }
    动作 { 设置全局变量(x, 加(0, 1)); }
}

规则 ("Global sets") {
    事件 { 持续 - 全局; }
    动作 {
        在索引处设置全局变量(A, 1, 全局.x);
        在索引处设置全局变量(A, 加(0, 1), 全局.x);
        在索引处设置全局变量(A, 减(5, 4), 全局.x);
        在索引处设置全局变量(A, 乘(2, 3), 全局.x);
        在索引处设置全局变量(A, 余数(7, 4), 全局.x);
        在索引处设置全局变量(A, 加(全局.x, 1), 全局.x);
        在索引处设置全局变量(A, 1, 乘(加(0, 1), 3));
        设置全局变量(x, 加(0, 1));
        设置全局变量(x, 数组中的值(全局.A, 加(0, 1)));
        设置全局变量(x, 数组中的值(全局.A, 减(1, 1)));
        设置全局变量(x, 首个(全局.A));
        在索引处修改全局变量(A, 1, 加, 2);
    }
}

规则 ("Player sets") {
    事件 { 持续 - 每名玩家; 双方; 全部; }
    动作 {
        在索引处设置玩家变量(事件玩家, P, 1, 全局.x);
        在索引处设置玩家变量(事件玩家, P, 加(0, 1), 全局.x);
        在索引处设置玩家变量(事件玩家, P, 减(5, 4), 全局.x);
        在索引处设置玩家变量(事件玩家, P, 乘(2, 3), 全局.x);
        在索引处设置玩家变量(事件玩家, P, 余数(7, 4), 全局.x);
        在索引处设置玩家变量(事件玩家, P, 加(全局.x, 1), 全局.x);
        在索引处设置玩家变量(事件玩家, P, 1, 乘(加(0, 1), 3));
        设置玩家变量(事件玩家, result, 加(0, 1));
        设置玩家变量(事件玩家, result, 数组中的值((事件玩家).P, 加(0, 1)));
        设置玩家变量(事件玩家, result, 数组中的值((事件玩家).P, 减(1, 1)));
        设置玩家变量(事件玩家, result, 首个((事件玩家).P));
        在索引处修改玩家变量(事件玩家, P, 1, 加, 2);
    }
}
