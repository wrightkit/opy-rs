    g = Invis.ENEMIES
    g = Invis.NONE
    g = Transform.ROTATION
    g = Transform.ROTATION_AND_TRANSLATION
    g = Status.ASLEEP
    g = Status.BURNING
    g = Status.FROZEN
    g = Status.HACKED
    g = Status.INVINCIBLE
    g = Status.KNOCKED_DOWN
    g = Status.PHASED_OUT
    g = Status.ROOTED
    g = Status.STUNNED
    g = Status.UNKILLABLE
    g = LosCheck.OFF
    g = LosCheck.SURFACES
    g = LosCheck.SURFACES_AND_ALL_BARRIERS
    g = LosCheck.SURFACES_AND_ENEMY_BARRIERS
    g = Team.ALL
